# Copy this file to .env (same folder) and fill it in. .env stays on this computer and is never committed.

# Instagram: from your Meta app > Instagram > API setup with Instagram login (the INSTAGRAM app ID and secret,
# not the Facebook app ID)
IG_APP_ID=
IG_APP_SECRET=

# TikTok: from developers.tiktok.com > your app > App details
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Who sees TikTok posts. Until TikTok audits the app, only SELF_ONLY works.
# After the audit, set PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY=SELF_ONLY

# Leave as is unless TikTok sign-in fails with a code_verifier error, then set to base64url
TIKTOK_PKCE=hex
